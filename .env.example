# Neonfi backend — environment template (Part 1)
# Source: System_Implementation §3 Required Environment Variables + Build Guide §1.2.
# Copy to `.env` and fill in. The Zod loader (src/lib/config.ts) validates ALL
# required vars at startup and FAILS FAST (exit 1) if any required var is missing
# or invalid. Never commit a filled-in .env. Never read process.env outside the
# loader.

# --- Core Application ---
APP_BASE_URL=          # Base URL of the deployed frontend (e.g. https://neonfi.app)
API_BASE_URL=          # Base URL of this Hono backend (e.g. https://api.neonfi.app)
NODE_ENV=development   # development | production | test

# --- Database (Neon, dual URL) ---
# DATABASE_URL is used at RUNTIME by Prisma Client and MUST be the POOLED string
#   (the `-pooler` host, PgBouncer).
# DIRECT_URL is used by Prisma MIGRATIONS (and the hypertable conversion) and MUST
#   be the DIRECT (non-pooled) host. Both are required.
DATABASE_URL=          # pooled, -pooler host
DIRECT_URL=            # direct, non-pooled host
DATABASE_URL_TEST=     # required only when NODE_ENV=test; may be empty in development

# --- Cache (Redis, self-hosted Coolify container, internal Docker network only) ---
# REDIS_URL must point at the internal Docker-network address — never a public host.
REDIS_URL=             # e.g. redis://redis:6379
REDIS_URL_TEST=        # required only when NODE_ENV=test; may be empty in development

# --- Authentication & Security ---
JWT_SECRET=            # >= 32 bytes / 256 bits (the loader enforces min length 32)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=         # secret used for signed cookies
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# --- Blockchain & Token Data ---
MORALIS_API_KEY=
MORALIS_WEBHOOK_SECRET=
COINBASE_WS_URL=
COINMARKETCAP_API_KEY=  # optional — only if CoinMarketCap is adopted (under evaluation)
COINRANKING_API_KEY=    # optional — only if CoinRanking is adopted (under evaluation)

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Logging & Monitoring ---
LOG_LEVEL=info          # debug | info | warn | error

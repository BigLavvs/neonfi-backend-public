# Neonfi backend — environment template (Part 1)
# Source: System_Implementation §3 Required Environment Variables + Build Guide §1.2.
# Copy to `.env` and fill in. The Zod loader (src/lib/config.ts) validates ALL
# required vars at startup and FAILS FAST (exit 1) if any required var is missing
# or invalid. Never commit a filled-in .env. Never read process.env outside the
# loader.

# --- Core Application ---
APP_BASE_URL=          # Base URL of the deployed frontend (e.g. https://neonfi.app)
API_BASE_URL=          # Base URL of this Hono backend (e.g. https://api.neonfi.app)
NODE_ENV=development   # development | production | test

# --- Database (Neon, dual URL) ---
# DATABASE_URL is used at RUNTIME by Prisma Client and MUST be the POOLED string
#   (the `-pooler` host, PgBouncer).
# DIRECT_URL is used by Prisma MIGRATIONS (and the hypertable conversion) and MUST
#   be the DIRECT (non-pooled) host. Both are required.
#
# retrofit-17 — HARDEN THE POOLED URL against Neon free-tier flakiness. Neon's
# free compute auto-suspends after 5 min idle (NOT configurable on free), so the
# first request after idle cold-starts the compute and can throw P1001 / P1017.
# APPEND these query params to the POOLED DATABASE_URL ONLY (leave DIRECT_URL
# untouched — migrations need a direct, non-pooled, non-PgBouncer connection):
#
#   &pgbouncer=true&connect_timeout=30&pool_timeout=20
#
#   - pgbouncer=true   — REQUIRED for Prisma through Neon's PgBouncer pooler;
#                        disables prepared statements that transaction-mode
#                        pooling breaks intermittently. Pooled URL ONLY.
#   - connect_timeout=30 — wait up to 30s for a cold compute to wake instead of
#                        erroring immediately on the first post-suspend query.
#   - pool_timeout=20  — raise Prisma's default 10s pool-wait so a brief wake
#                        doesn't trip a pool timeout.
#
# Example pooled value (note the params):
#   postgresql://USER:PASS@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=20
DATABASE_URL=          # pooled, -pooler host — append the retrofit-17 params above
DIRECT_URL=            # direct, non-pooled host — DO NOT add pgbouncer=true here
DATABASE_URL_TEST=     # required only when NODE_ENV=test; may be empty in development

# --- Cache (Redis, self-hosted Coolify container, internal Docker network only) ---
# REDIS_URL must point at the internal Docker-network address — never a public host.
REDIS_URL=             # e.g. redis://redis:6379
REDIS_URL_TEST=        # required only when NODE_ENV=test; may be empty in development

# --- Authentication & Security ---
JWT_SECRET=            # >= 32 bytes / 256 bits (the loader enforces min length 32)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=         # secret used for signed cookies
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=  # dev: http://localhost:3000/api/v1/auth/google/callback

# --- Auth rate-limiting & lockout (Build Guide Appendix item 10) ---
# Number of consecutive failed logins before an email is locked out.
AUTH_LOGIN_MAX_ATTEMPTS=5
# Duration the lockout lasts, in milliseconds.  Default: 900000 = 15 minutes.
AUTH_LOGIN_LOCKOUT_MS=900000

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# --- Blockchain & Token Data ---
MORALIS_API_KEY=
MORALIS_WEBHOOK_SECRET=
COINBASE_WS_URL=
COINMARKETCAP_API_KEY=  # optional — only if CoinMarketCap is adopted (under evaluation)
COINRANKING_API_KEY=    # optional — only if CoinRanking is adopted (under evaluation)

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Logging & Monitoring ---
LOG_LEVEL=info          # debug | info | warn | error

# --- Token metadata sync (Stage 9B) ---
TOKEN_SYNC_ENABLED=true          # set to false to disable the background sync job
TOKEN_SYNC_CRON=0 */6 * * *      # cron expression — default every 6 hours at minute 0

# --- Daily balance snapshot job (Stage 13) ---
SNAPSHOT_ENABLED=true            # set to false to disable the daily snapshot job (exact string "false" disables)
SNAPSHOT_CRON=0 0 * * *          # cron expression — default midnight UTC, every day

# --- DB keep-alive ping (retrofit-17, OPTIONAL — default OFF) ---
# Pings `SELECT 1` every 4 min to stop Neon free-tier compute scale-to-zero (5-min
# idle auto-suspend), eliminating the slow first request after idle. TRADEOFF: it
# keeps the compute awake continuously, consuming free-tier compute-hours — opt in
# only for active dev. Exact string "true" enables; anything else (incl. unset)
# leaves it off.
DB_KEEPALIVE_ENABLED=false

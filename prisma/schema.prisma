// Neonfi backend — Prisma schema
//
// SOURCE OF TRUTH: `Neonfi Database Schema.docx` (reproduced verbatim from the
// plain-text export `docs/schema.txt`). Per Build Guide §0.1, this schema is
// authoritative for tables, columns, types, relations, enums-as-lookup-tables,
// cascade behavior, and uniqueness constraints. Do NOT "improve" types,
// relations, or @@map names.
//
// Deliberate, non-divergent additions (allowed by Build Guide §1.3 / §3.3 — they
// change no wire shape or column semantics):
//   - datasource declares both `url` (pooled DATABASE_URL) and `directUrl`
//     (DIRECT_URL) per the Neon + Prisma requirement.
//   - @@index added on FK scalar fields that Prisma does not auto-index, plus the
//     frequently-queried `Portfolio.walletAddress` (System_Architecture Database
//     Optimization). Fields already covered by @unique or as the leftmost column
//     of a composite @@unique are not re-indexed.
//
// Enums are lookup TABLES (id + name + back-relation), never native Postgres
// enums (§0.4). Seed rows live in prisma/seed.ts.
//
// BalanceSnapshot is defined here as a regular table; its conversion to a
// TimescaleDB hypertable is a raw-SQL step run AFTER `prisma migrate deploy`
// (see prisma/sql/001_timescaledb_hypertable.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// USER & ACCESS CONTROL

model User {
  id                   Int               @id @default(autoincrement())
  email                String            @unique @db.VarChar(255)
  passwordHash         String? // null for Google OAuth users
  fullName             String            @db.VarChar(255)
  displayName          String?           @db.VarChar(100)
  avatarUrl            String?           @db.VarChar(2048)
  authProvider         AuthProvider      @relation("UserAuthProvider", fields: [authProviderId], references: [id])
  authProviderId       Int
  onboardingStatus     OnboardingStatus  @relation("UserOnboardingStatus", fields: [onboardingStatusId], references: [id])
  onboardingStatusId   Int
  newsletterSubscribed Boolean           @default(false)
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, retrofit-5): the
  // settings Preferences tab persists notification/display preferences the docx
  // never defined. priceAlertsEnabled gates price-alert notifications, pushEnabled
  // gates push delivery, and baseCurrency is the user's display currency (ISO-4217,
  // matches the frontend selector: USD|EUR|GBP|JPY|NGN). Surfaced on GET /users/me
  // and written by PATCH /users/preferences.
  priceAlertsEnabled   Boolean           @default(true)
  pushEnabled          Boolean           @default(false)
  baseCurrency         String            @default("USD") @db.VarChar(3)

  // One to One
  subscription         Subscription?

  // One to Many
  sessions             Session[]
  portfolios           Portfolio[]
  payments             Payment[]
  snapshots            BalanceSnapshot[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([authProviderId])
  @@index([onboardingStatusId])
  @@map("user")
}

model AuthProvider {
  id    Int    @id @default(autoincrement())
  name  String @unique // email | google
  users User[] @relation("UserAuthProvider")

  @@map("auth_provider")
}

model OnboardingStatus {
  id    Int    @id @default(autoincrement())
  name  String @unique // pending_verification | verified | plan_selected | complete
  users User[] @relation("UserOnboardingStatus")

  @@map("onboarding_status")
}

model Session {
  id               Int       @id @default(autoincrement())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  ipAddress        String?   @db.VarChar(45)
  userAgent        String?   @db.VarChar(512)
  expiresAt        DateTime
  revokedAt        DateTime?
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, same pattern as
  // Payment.user and BalanceSnapshot PK): the docx defines stateful refresh
  // sessions but omits the column required to look up a session by its refresh
  // token.  Without this field, POST /auth/refresh cannot match the incoming
  // refresh cookie to a Session row.  The 64-char VarChar holds the hex-encoded
  // SHA-256 hash of the 32-byte random refresh token; the raw token is stored
  // only in the HttpOnly `refresh` cookie, never in the database.
  refreshTokenHash String    @unique @db.VarChar(64)
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("session")
}

// SUBSCRIPTION & PAYMENTS

model Subscription {
  id                      Int                @id @default(autoincrement())
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  Int                @unique
  plan                    Plan               @relation("SubscriptionPlan", fields: [planId], references: [id])
  planId                  Int
  billingCycle            BillingCycle?      @relation("SubscriptionBillingCycle", fields: [billingCycleId], references: [id])
  billingCycleId          Int? // null for free plan
  status                  SubscriptionStatus @relation("SubscriptionStatus", fields: [statusId], references: [id])
  statusId                Int
  stripeCustomerId        String?            @db.VarChar(255)
  stripeSubscriptionId    String?            @db.VarChar(255)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  // Deferred change fields: set when user schedules a downgrade that takes effect
  // at currentPeriodEnd. Stage 4 webhook clears them after the period transitions.
  scheduledPlan           Plan?              @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id])
  scheduledPlanId         Int?
  scheduledBillingCycle   BillingCycle?      @relation("ScheduledBillingCycle", fields: [scheduledBillingCycleId], references: [id])
  scheduledBillingCycleId Int?
  payments                Payment[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([planId])
  @@index([billingCycleId])
  @@index([statusId])
  @@index([scheduledPlanId])
  @@index([scheduledBillingCycleId])
  @@map("subscription")
}

model Plan {
  id                     Int            @id @default(autoincrement())
  name                   String         @unique // free | pro
  subscriptions          Subscription[] @relation("SubscriptionPlan")
  scheduledSubscriptions Subscription[] @relation("ScheduledPlan")
  pros                   String[] //list of advantages of plan
  cons                   String[]

  @@map("plan")
}

model BillingCycle {
  id                     Int            @id @default(autoincrement())
  name                   String         @unique // monthly | yearly
  subscriptions          Subscription[] @relation("SubscriptionBillingCycle")
  scheduledSubscriptions Subscription[] @relation("ScheduledBillingCycle")

  @@map("billing_cycle")
}

model SubscriptionStatus {
  id            Int            @id @default(autoincrement())
  name          String         @unique // active | cancelled | expired
  subscriptions Subscription[] @relation("SubscriptionStatus")

  @@map("subscription_status")
}

model Payment {
  id                    Int           @id @default(autoincrement())
  // NOTE (faithful-to-intent, not a contract change): schema.txt writes the
  // relation type as `User` (non-optional) alongside a nullable `userId Int?`
  // with onDelete: SetNull. Prisma requires the relation field to be optional
  // (`User?`) whenever its FK scalar is nullable, so the literal text is invalid
  // Prisma. `User?` is the only valid encoding of the documented intent
  // (nullable userId + SetNull → payment history survives user deletion,
  // Schema:179–181 / Build Guide Stage 4). No column/semantic divergence.
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                Int?
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, retrofit-5): the
  // docx writes subscriptionId as a required FK with default Restrict, which makes
  // deleting a user impossible — the user→Subscription cascade (line 109) would be
  // blocked by any Payment still referencing that Subscription. Account deletion
  // (DELETE /users/me) must hard-delete the user while preserving payment history
  // for accounting. So, mirroring the Payment.user SetNull above, subscriptionId is
  // optional + SetNull: after the user and subscription rows are gone, the payment
  // row survives with userId=null AND subscriptionId=null, retaining
  // stripePaymentIntentId/amount/currency/status/createdAt. The Stage 4 webhook
  // write path always supplies subscriptionId, so nullability changes no write.
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId        Int?
  stripePaymentIntentId String        @unique @db.VarChar(255)
  amount                Int // in smallest currency unit e.g. cents
  currency              String        @db.VarChar(3)
  status                PaymentStatus @relation("PaymentStatus", fields: [statusId], references: [id])
  statusId              Int
  refundAvailable       Boolean       @default(false)
  createdAt             DateTime      @default(now())

  @@index([userId])
  @@index([subscriptionId])
  @@index([statusId])
  @@map("payment")
}

model PaymentStatus {
  id       Int       @id @default(autoincrement())
  name     String    @unique // pending | succeeded | failed | refunded
  payments Payment[] @relation("PaymentStatus")

  @@map("payment_status")
}

// CATALOGUE

model Chain {
  id         Int         @id @default(autoincrement())
  name       String      @unique @db.VarChar(100)
  slug       String      @unique @db.VarChar(50)
  logoUrl    String?     @db.VarChar(2048)
  moralisId  String      @unique @db.VarChar(20)
  portfolios Portfolio[]

  @@map("chain")
}

model Token {
  id           Int      @id @default(autoincrement())
  // retrofit-58 Part 4: widened from VarChar(255)/VarChar(20). Connected-wallet sync
  // auto-lists arbitrary on-chain tokens, and scam/airdrop tokens stuff long URLs into their
  // name/symbol — the old bounds threw "value too long for column" and the token was silently
  // skipped (retrofit-57). name → Text (genuinely free text); symbol stays bounded but generous
  // (still the unique catalog key + a Redis key, so not unbounded).
  name         String   @db.Text
  symbol       String   @unique @db.VarChar(255)
  logoUrl      String?  @db.VarChar(2048)
  currentPrice Decimal  @db.Decimal(20, 8)
  marketCap    Decimal? @db.Decimal(30, 2)
  rank         Int?
  // retrofit-39: last-known 24h % change from CMC (6-hourly sync + catalog ingest). A
  // cold-cache fallback so the wallet badge shows a (slightly stale) change even for a
  // token with no fresh live `price:<SYM>` tick. Nullable — unknown until first written.
  change24h    Decimal? @db.Decimal(10, 4)
  // retrofit-48: on-chain identity for precise connected-wallet resolution + per-contract
  // re-pricing. Nullable because existing CMC catalog rows have no contract recorded. NOT
  // unique (the same contract string can recur across chains, and `symbol` stays the unique
  // key) — indexed for lookups only. Stored lower-cased for EVM; Solana mints left as-is.
  contractAddress String? @db.VarChar(255)
  // retrofit-48: true when this row was auto-created from a connected wallet's holdings (not
  // the CMC catalog). These tokens are NOT on the live firehose, so the connected-reprice job
  // refreshes their price. CMC/catalog tokens stay false and are priced by token-sync + the
  // firehose.
  autoListed   Boolean  @default(false)
  // retrofit-71 (C4): confidence in this row's price. 'verified' = confirmed against a canonical
  // feed (CoinGecko by contract); 'unverified' = an auto-listed wallet token whose provider price
  // could not be cross-checked (the UI marks/excludes it rather than presenting it as fact). null =
  // CMC catalog rows (trusted by default). Set 'unverified' on auto-list; upgraded to 'verified'
  // (and the price corrected) by the connected-reprice job when a canonical price is found.
  priceConfidence String? @db.VarChar(20)
  assets       Asset[]
  // retrofit-21: daily price-history rows (powers the token-detail chart + ATH/ATL).
  priceSnapshots TokenPriceSnapshot[]

  updatedAt    DateTime @updatedAt

  @@index([contractAddress])
  @@map("token")
}

// retrofit-21: daily per-token USD price snapshot. Modelled on BalanceSnapshot —
// composite PK (tokenId, snapshotDate) makes the daily sampling upsert idempotent
// (a same-day re-run rewrites the price, never a second row). Prices are GLOBAL
// (catalog-wide, not per-user, not Pro-gated), sampled by snapshot.job.ts. Plain
// table, NOT a TimescaleDB hypertable — daily granularity keeps row counts tiny, so
// the MVP doesn't need chunking/retention here.
model TokenPriceSnapshot {
  id           Int      @default(autoincrement())
  token        Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tokenId      Int
  price        Decimal  @db.Decimal(20, 8)
  snapshotDate DateTime @db.Date

  createdAt    DateTime @default(now())

  @@id([tokenId, snapshotDate])
  @@index([tokenId])
  @@map("token_price_snapshot")
}

// PORTFOLIOS

model Portfolio {
  id              Int               @id @default(autoincrement())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  name            String            @db.VarChar(255)
  type            PortfolioType     @relation("PortfolioType", fields: [typeId], references: [id])
  typeId          Int
  walletAddress   String?           @db.VarChar(255)
  chain           Chain?            @relation(fields: [chainId], references: [id])
  chainId         Int? // null for manual portfolios
  startingBalance Decimal?          @db.Decimal(20, 8) // null for wallet-connected
  netDeposit      Decimal           @default(0) @db.Decimal(20, 8)
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, Stage 12): Moralis
  // Streams stream ID for this connected portfolio. Null for manual portfolios and
  // until the stream is created. Used by deletePortfolio to clean up the stream.
  moralisStreamId String?           @db.VarChar(255)
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, retrofit-49): connected-
  // wallet transfer-history import. syncCursor is the provider's pagination cursor for the
  // "load more" endpoint (null = no more / done / not connected); externalTxCount is the
  // provider-reported total tx count for the wallet (null when unknown — the overview count
  // then falls back to the imported DB row count). Untyped String → Postgres `text` because
  // Moralis cursors are long opaque tokens.
  syncCursor      String?
  externalTxCount Int?

  // One to Many
  assets          Asset[]
  transactions    Transaction[]
  nfts            Nft[]
  snapshots       BalanceSnapshot[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([typeId])
  @@index([chainId])
  @@index([walletAddress])
  @@map("portfolio")
}

model PortfolioType {
  id         Int         @id @default(autoincrement())
  name       String      @unique // connected | manual
  portfolios Portfolio[] @relation("PortfolioType")

  @@map("portfolio_type")
}

model Asset {
  id          Int       @id @default(autoincrement())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId Int
  token       Token     @relation(fields: [tokenId], references: [id])
  tokenId     Int
  balance     Decimal   @default(0) @db.Decimal(20, 8)
  // NOTE (retrofit-2, kept by retrofit-27): Σ(buy usdValue) − Σ(sell usdValue) over
  // this asset's transactions. retrofit-27 introduced the average-cost model below as
  // the new PnL basis, but netDeposit stays MAINTAINED by recalc (Augment decision) so
  // the legacy netDeposit-based pnlAllTime*/analytics-summary numbers don't go stale.
  netDeposit  Decimal   @default(0) @db.Decimal(20, 8)
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, retrofit-27): average-cost
  // PnL + opening balances. An OPENING position seeds a pre-existing holding that is NOT a
  // trade (written once at asset creation; immutable — no PATCH path). Cost-unknown opening
  // (openingCostBasis null) is excluded from average cost AND unrealized PnL.
  openingBalance   Decimal   @default(0) @db.Decimal(20, 8) // starting qty (same scale as balance)
  openingCostBasis Decimal?  @db.Decimal(20, 8) // total USD cost of the opening qty; null = "don't track cost"
  openingAt        DateTime? // as-of date for 'historical' cost mode (null otherwise)
  // Maintained by recalc.ts from the opening lot + chronological buys/sells:
  realizedPnl Decimal   @default(0) @db.Decimal(20, 8) // cumulative realized PnL (USD)
  avgCost     Decimal?  @db.Decimal(20, 8) // average cost of currently-held cost-known units; null = no cost basis
  costBasis   Decimal   @default(0) @db.Decimal(20, 8) // USD basis of the currently-held cost-known units

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([portfolioId, tokenId])
  @@index([tokenId])
  @@map("asset")
}

// TRANSACTIONS (POLYMORPHIC)

model Transaction {
  id              Int                      @id @default(autoincrement())
  portfolio       Portfolio                @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId     Int
  type            TransactionType          @relation("TransactionType", fields: [typeId], references: [id])
  typeId          Int
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, same pattern as
  // Session.refreshTokenHash, Subscription.scheduledPlanId): architecture rep
  // treats direction as first-class ("buy | sell | transfer") and the balance
  // recalc rule reads from it, but the schema docx omits the column.
  direction       TransactionDirection     @relation("TransactionDirection", fields: [directionId], references: [id])
  directionId     Int
  from            String?                  @db.VarChar(255)
  to              String?                  @db.VarChar(255)
  gasFee          Decimal?                 @db.Decimal(20, 8)
  // retrofit-74 (§4): the hash is unique PER PORTFOLIO, not globally (see @@unique below).
  // A wallet re-added in a second portfolio (or shared across two) must import its transfers
  // into each rather than being globally dedup-blocked after the first import.
  transactionHash String?                  @db.VarChar(255)
  timestamp       DateTime
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, retrofit-7): free-text
  // user note attached to a manually-logged transaction (frontend AddTransactionModal).
  // Optional; null for webhook/connected transactions.
  notes           String?                  @db.VarChar(2000)
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, retrofit-10): links the
  // two legs of a cross-portfolio transfer (a `sell` in the source portfolio + a `buy`
  // in the dest, sharing this UUID) so they can be grouped/labelled and deleted as a
  // pair. Null for all non-transfer transactions.
  transferGroupId String?                  @db.VarChar(36)

  // Child detail records
  nativeDetail    NativeTransactionDetail?
  erc20Detail     Erc20TransactionDetail?
  nftDetail       NftTransactionDetail?

  createdAt       DateTime                 @default(now())

  // retrofit-74 (§4): per-portfolio hash uniqueness (was a global @unique on transactionHash).
  // Null hashes (manual transactions) stay distinct under a Postgres unique index, so multiple
  // hash-less rows per portfolio are still allowed.
  @@unique([portfolioId, transactionHash])
  @@index([portfolioId])
  // audit perf #23: dashboard/overview reads filter by portfolio + sort by timestamp; without
  // this composite, Postgres full-sorts the user's whole tx set on every load (and on each
  // per-portfolio earliest-date lookup). Leading portfolioId keeps the existing single-column
  // lookups covered too.
  @@index([portfolioId, timestamp])
  @@index([typeId])
  @@index([directionId])
  @@index([transferGroupId])
  @@map("transaction")
}

model TransactionDirection {
  id           Int           @id @default(autoincrement())
  name         String        @unique // buy | sell | transfer
  transactions Transaction[] @relation("TransactionDirection")

  @@map("transaction_direction")
}

model TransactionType {
  id           Int           @id @default(autoincrement())
  name         String        @unique // native | erc20 | nft
  transactions Transaction[] @relation("TransactionType")

  @@map("transaction_type")
}

model NativeTransactionDetail {
  id            Int         @id @default(autoincrement())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId Int         @unique
  amount        Decimal     @db.Decimal(20, 8)
  symbol        String      @db.VarChar(255) // retrofit-58 Part 4: widened from 20 (arbitrary on-chain symbols)
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, retrofit-2): USD
  // value of the transfer at write-time (amount × price). Implements Option (a)
  // for USD-at-transaction-time so manual/connected PnL stops being fictional.
  // MVP simplification: this is the CURRENT price at write-time — historical txns
  // (and the migration backfill) use current price, NOT the historical price.
  // PnL is therefore approximate; see src/modules/transactions/usd-value.ts.
  usdValue      Decimal     @db.Decimal(20, 8)
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, retrofit-7): user-entered
  // price at tx time; drives usdValue for manual entries. Null for webhook/connected
  // (current price). Reverses the retrofit-2 "current price" simplification for manual txns.
  priceAtTime   Decimal?    @db.Decimal(20, 8)

  // audit perf #3/#4: recalcAssetBalance filters this table by `symbol` on every tx write
  // (amplified K× in bulk import loops); un-indexed it forces a full scan per call.
  @@index([symbol])
  @@map("native_transaction_detail")
}

model Erc20TransactionDetail {
  id                   Int         @id @default(autoincrement())
  transaction          Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId        Int         @unique
  amount               Decimal     @db.Decimal(20, 8)
  // retrofit-58 Part 4: widened from VarChar(20)/VarChar(255) — connected-wallet history import
  // feeds raw on-chain symbols/names straight in, and scam tokens overflow the old bounds.
  symbol               String      @db.VarChar(255)
  tokenContractAddress String      @db.VarChar(255)
  tokenName            String      @db.Text
  tokenSymbol          String      @db.VarChar(255)
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, retrofit-2): USD
  // value of the transfer at write-time (amount × price). Same "current price at
  // write-time" MVP simplification as NativeTransactionDetail.usdValue above; see
  // src/modules/transactions/usd-value.ts.
  usdValue             Decimal     @db.Decimal(20, 8)
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, retrofit-7): user-entered
  // price at tx time; drives usdValue for manual entries. Null for webhook/connected
  // (current price). Reverses the retrofit-2 "current price" simplification for manual txns.
  priceAtTime          Decimal?    @db.Decimal(20, 8)

  // audit perf #3/#4: recalcAssetBalance filters this table by `symbol` on every tx write
  // (amplified K× in bulk import loops); un-indexed it forces a full scan per call.
  @@index([symbol])
  @@map("erc20_transaction_detail")
}

model NftTransactionDetail {
  id                   Int         @id @default(autoincrement())
  transaction          Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId        Int         @unique
  tokenContractAddress String      @db.VarChar(255)
  nftName              String?     @db.VarChar(255)
  nftTokenId           String      @db.VarChar(255)
  collectionName       String?     @db.VarChar(255)

  @@map("nft_transaction_detail")
}

// NFT HOLDINGS

model Nft {
  id              Int       @id @default(autoincrement())
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId     Int
  name            String?   @db.VarChar(255)
  description     String?   // retrofit-51: collectible description (normalized_metadata.description); null when absent
  tokenId         String    @db.VarChar(255)
  contractAddress String    @db.VarChar(255)
  collectionName  String?   @db.VarChar(255)
  logoUrl         String?   @db.Text // was VarChar(2048); on-chain data: URI SVGs (e.g. Uniswap V3 LP positions) overflow 2048 (retrofit-55)
  chain           String    @db.VarChar(50)
  // NOTE (schema delta beyond docx — Idowu owns the docx edit, Stage 12): architecture
  // rep specifies 7 marketplace fields that the schema docx omits. Same defect pattern
  // as Session.refreshTokenHash, Transaction.directionId. All nullable — Moralis
  // returns them when available; DTO returns null otherwise.
  tokenStandard   String?   @db.VarChar(50)
  floorPrice      String?   @db.VarChar(50)
  floorPriceUsd   String?   @db.VarChar(50)
  lastSale        String?   @db.VarChar(50)
  lastSaleNote    String?   @db.VarChar(100)
  rarity          String?   @db.VarChar(100)
  traits          Json?
  // retrofit-73 (H13): Moralis' possible_spam flag, persisted so airdrop/scam NFTs
  // ("Hefty Presents" ×17, "Garbage Bags") can be filtered out of the holdings list / badged
  // instead of presented as real holdings. Default false (legacy + non-spam rows).
  possibleSpam    Boolean   @default(false)
  // retrofit-84 (H13): the COMBINED spam verdict — provider flags (Moralis possible_spam, Alchemy
  // spam-contract DB, GoldRush is_spam) ORed with the curated blocklist + bulk held-count + a
  // conservative name/collection heuristic. This is the field the holdings list + NFT count filter
  // on (possibleSpam stays the raw provider signal). Default false; set during NFT sync and
  // re-evaluated by the reclassify backfill / webhook.
  spam            Boolean   @default(false)
  // retrofit-86 (H13.1): per-NFT MANUAL override of the computed `spam` verdict — the honest
  // two-way escape hatch for the behavioral signal's residual FP risk. true = force spam (hide),
  // false = force visible, null = no override (use computed `spam`). Applied at READ time
  // (effectiveNftSpam = spamOverride ?? spam) so a resync recomputing `spam` never clobbers it.
  spamOverride    Boolean?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([portfolioId, contractAddress, tokenId])
  @@map("nft")
}

// BALANCE SNAPSHOTS (TimescaleDB hypertable)

model BalanceSnapshot {
  // Schema docx defect (Idowu owns the docx edit, do NOT modify the docx from here):
  // docx writes `id Int @id @default(autoincrement())` while also requiring this
  // table to become a TimescaleDB hypertable on `snapshotDate`. TimescaleDB rejects
  // that combination (TS103: partition column must be in every unique constraint,
  // including the PK). Resolution (Option C, signed off by Idowu): keep `id` as a
  // non-PK autoincrement column with NO @unique (so it does not create a
  // partition-column-less unique index), and make `(portfolioId, snapshotDate)` the
  // composite PK — which subsumes the docx's @@unique on the same columns and
  // satisfies TimescaleDB. The architecture.docx resource rep still returns `id`
  // unchanged.
  id           Int       @default(autoincrement())
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId  Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  value        Decimal   @db.Decimal(20, 8)
  snapshotDate DateTime  @db.Date

  // retrofit-77 (N1): provenance flag. true = a backfilled ESTIMATE (connected-wallet
  // initial-sync net-worth-at-block, approximate: historical balance × ~today's price).
  // false = a REAL observed snapshot (daily job + the live "today" stitch). The short-term
  // (24h/7d/30d) baseline lookup ignores approx rows so a freshly-synced wallet shows "—"
  // until real snapshots accrue, instead of a garbage delta off an inflated estimate.
  approx       Boolean   @default(false)

  createdAt    DateTime  @default(now())

  @@id([portfolioId, snapshotDate])
  @@index([userId])
  @@map("balance_snapshot")
  // Conversion to TimescaleDB hypertable: prisma/sql/001_timescaledb_hypertable.sql,
  // runs after prisma migrate deploy. Partition column is `snapshotDate` (camelCase
  // — the docx's `'snapshot_date'` spelling is a docx typo per §0.4 column-naming
  // rule; Idowu owns the docx edit).
}

{
  "name": "neonfi-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Neonfi backend - Hono + TypeScript API and WebSocket server",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "npm run check:singletons && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check:singletons": "node scripts/check-singletons.mjs",
    "check:file-sizes": "node scripts/check-file-sizes.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:hypertable": "tsx prisma/sql/run-hypertable.ts",
    "db:seed": "prisma db seed",
    "seed:tokens": "tsx src/scripts/seed-catalog.ts",
    "backfill:costbasis": "tsx src/scripts/backfill-costbasis.ts",
    "backfill:snapshots": "tsx src/scripts/backfill-snapshots.ts",
    "reclassify:snapshots": "tsx src/scripts/reclassify-connected-snapshots.ts",
    "reclassify:nft-spam": "tsx src/scripts/reclassify-nft-spam.ts",
    "rebuild:connected-history": "tsx src/scripts/rebuild-connected-history.ts",
    "test": "vitest run",
    "check": "npm run check:file-sizes && npm run typecheck"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "engineStrict": false,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@hono/node-server": "^1.13.7",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "google-auth-library": "^10.7.0",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "jose": "^6.2.3",
    "js-sha3": "^0.9.3",
    "node-cron": "^4.2.1",
    "stripe": "^22.2.0",
    "ws": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
